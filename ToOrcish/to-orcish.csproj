<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>to-orcish</AssemblyName>
    <RootNamespace>PlayerAssistant</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <OutputPath>..\Release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OrcishLexiconReviewUtility.cs" Link="OrcishLexiconReviewUtility.cs" />
    <Compile Include="..\OrcishTranslatorUtility.BlogHighYieldBatch.cs" Link="OrcishTranslatorUtility.BlogHighYieldBatch.cs" />
    <Compile Include="..\OrcishTranslatorUtility.BlogMixedHighYieldBatch.cs" Link="OrcishTranslatorUtility.BlogMixedHighYieldBatch.cs" />
    <Compile Include="..\OrcishTranslatorUtility.BlogFollowupBatch.cs" Link="OrcishTranslatorUtility.BlogFollowupBatch.cs" />
    <Compile Include="..\OrcishTranslatorUtility.ShadowdimBlogBatch.cs" Link="OrcishTranslatorUtility.ShadowdimBlogBatch.cs" />
    <Compile Include="..\OrcishTranslatorUtility.cs" Link="OrcishTranslatorUtility.cs" />
    <Compile Include="..\RandomNumberUtility.cs" Link="RandomNumberUtility.cs" />
  </ItemGroup>

</Project>
