AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType image/webp .webp

RewriteEngine On
RewriteRule ^XP(?:/|$) - [R=404,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self' https://publish-01.obsidian.md; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data: https://*.obsidian.md; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'; upgrade-insecure-requests"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header set Cache-Control "no-cache" "expr=%{REQUEST_URI} =~ m#/(service-worker\.js|manifest\.webmanifest|level-progression\.json|magic-items\.json|party-funds\.json|quests\.json|data/heroes\.json|data/hero-tokens/[^/]+)$#"
</IfModule>
