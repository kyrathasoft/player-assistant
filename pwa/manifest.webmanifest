{
    "id": "./",
    "name": "Player Assistant — Scarlet Horizons",
    "short_name": "Player Assistant",
    "description": "Campaign tools, Orcish and Elvish translation, public lore search, and dice for Scarlet Horizons players.",
    "lang": "en-US",
    "start_url": "./#dashboard",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#110e0c",
    "theme_color": "#241813",
    "categories": ["games", "utilities", "entertainment"],
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Translator",
            "short_name": "Translator",
            "url": "./#translator",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Campaign Search",
            "short_name": "Search",
            "url": "./#search",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Dice Roller",
            "short_name": "Dice",
            "url": "./#dice",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        }
    ]
}
