<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>player-assistant</AssemblyName>
    <RootNamespace>PlayerAssistant</RootNamespace>
    <Version>$(PlayerAssistantVersion)</Version>
    <AssemblyVersion>$(PlayerAssistantAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(PlayerAssistantAssemblyVersion)</FileVersion>
    <InformationalVersion>$(PlayerAssistantVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\dragon-icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <OutputPath>Release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="Release\**\*.cs" />
    <Compile Remove="Debug\**\*.cs" />
    <Compile Remove="obj-*\**\*.cs" />
    <Compile Remove="bin-*\**\*.cs" />
    <Compile Remove="Release-*\**\*.cs" />
    <Compile Remove="Debug-*\**\*.cs" />
    <Compile Remove="codex-scratch\**\*.cs" />
    <Compile Remove="ToOrcish\**\*.cs" />
    <Compile Remove="ToElvish\**\*" />
    <Compile Remove="PlayerAssistant.Launcher\**\*.cs" />
    <Compile Remove="PlayerAssistant.Tests\**\*.cs" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove="bin\**\*" />
    <EmbeddedResource Remove="Release\**\*" />
    <EmbeddedResource Remove="Debug\**\*" />
    <EmbeddedResource Remove="obj-*\**\*" />
    <EmbeddedResource Remove="bin-*\**\*" />
    <EmbeddedResource Remove="Release-*\**\*" />
    <EmbeddedResource Remove="Debug-*\**\*" />
    <EmbeddedResource Remove="codex-scratch\**\*" />
    <EmbeddedResource Remove="ToOrcish\**\*" />
    <EmbeddedResource Remove="ToElvish\**\*" />
    <EmbeddedResource Remove="PlayerAssistant.Launcher\**\*" />
    <EmbeddedResource Remove="PlayerAssistant.Tests\**\*" />
    <None Remove="obj\**\*" />
    <None Remove="bin\**\*" />
    <None Remove="Release\**\*" />
    <None Remove="Debug\**\*" />
    <None Remove="obj-*\**\*" />
    <None Remove="bin-*\**\*" />
    <None Remove="Release-*\**\*" />
    <None Remove="Debug-*\**\*" />
    <None Remove="codex-scratch\**\*" />
    <None Remove="ToOrcish\**\*" />
    <None Remove="ToElvish\**\*" />
    <None Remove="PlayerAssistant.Launcher\**\*" />
    <None Remove="PlayerAssistant.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\dragon-icon.ico" />
    <EmbeddedResource Include="Assets\dragon-dim.png" />
    <EmbeddedResource Include="Assets\white-marble.png" />
    <EmbeddedResource Include="web-translator\orcish-lexicon.json" LogicalName="PlayerAssistant.OrcishLexiconSnapshot.json" />
    <EmbeddedResource Include="web-translator\elven-lexicon.json" LogicalName="PlayerAssistant.ElvenLexiconSnapshot.json" />
    <EmbeddedResource Include="web-translator\ghukliak-lexicon.json" LogicalName="PlayerAssistant.GhukliakLexicon.json" />
    <EmbeddedResource Include="web-translator\ghukliak-complete-coverage.json" LogicalName="PlayerAssistant.GhukliakCompleteCoverage.json" />
    <EmbeddedResource Include="web-translator\elven-translations.json" LogicalName="PlayerAssistant.ElvenTranslationDictionary.json" />
    <EmbeddedResource Include="web-translator\elven-first-iteration.json" LogicalName="PlayerAssistant.ElvenFirstIteration.json" />
    <EmbeddedResource Include="web-translator\elven-second-iteration.json" LogicalName="PlayerAssistant.ElvenSecondIteration.json" />
    <EmbeddedResource Include="web-translator\elven-complete-coverage.json" LogicalName="PlayerAssistant.ElvenCompleteCoverage.json" />
    <None Remove="web-translator\orcish-lexicon.json" />
    <None Remove="web-translator\elven-lexicon.json" />
    <None Remove="web-translator\ghukliak-lexicon.json" />
    <None Remove="web-translator\ghukliak-complete-coverage.json" />
    <None Remove="web-translator\elven-translations.json" />
    <None Remove="web-translator\elven-first-iteration.json" />
    <None Remove="web-translator\elven-second-iteration.json" />
    <None Remove="web-translator\elven-complete-coverage.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="resource-budgets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="game-posts-key-terms.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="class-progression.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="pwa\magic-items.json">
      <Link>magic-items.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="settings.local.json" Condition="Exists('settings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Include="xp-passwords.json" Condition="Exists('xp-passwords.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core" Condition="Exists('$(NuGetPackageRoot)microsoft.web.webview2\1.0.4022.49\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll')">
      <HintPath>$(NuGetPackageRoot)microsoft.web.webview2\1.0.4022.49\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms" Condition="Exists('$(NuGetPackageRoot)microsoft.web.webview2\1.0.4022.49\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll')">
      <HintPath>$(NuGetPackageRoot)microsoft.web.webview2\1.0.4022.49\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="CopyKeywordIndexToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutputPath)keyword-index.json" DestinationFiles="$(PublishDir)keyword-index.json" Condition="Exists('$(OutputPath)keyword-index.json')" />
  </Target>

  <Target Name="CopyPlaywrightRuntimeToPublish" AfterTargets="Publish">
    <Exec Command="if exist &quot;$(OutputPath).playwright&quot; xcopy &quot;$(OutputPath).playwright&quot; &quot;$(PublishDir).playwright\&quot; /E /I /Y /H &gt;nul" Condition="Exists('$(OutputPath).playwright')" />
  </Target>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
